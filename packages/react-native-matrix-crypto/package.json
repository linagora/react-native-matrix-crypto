{
  "name": "react-native-matrix-crypto",
  "version": "0.4.0",
  "description": "A React Native bridge for Matrix cryptography",
  "license": "Apache-2.0",
  "homepage": "https://github.com/linagora/react-native-matrix-crypto",
  "author": "Linagora",
  "repository": {
    "type": "git",
    "url": "https://github.com/linagora/react-native-matrix-crypto.git"
  },
  "main": "src/index.ts",
  "files": [
    "src",
    "cpp",
    "interop",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/cpp-adapter.cpp",
    "android/proguard-rules.pro",
    "android/src/main",
    "ios",
    "*.podspec",
    "MatrixCryptoFramework.xcframework",
    "LICENSE",
    "README.md",
    "!src/**/*.test.ts",
    "!src/**/*.type-test.ts",
    "!interop/**/*.test.ts"
  ],
  "codegenConfig": {
    "name": "RNNativeModuleSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.matrixcrypto"
    }
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": "^0.87.0"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-5",
    "uniffi-bindgen-react-native": "0.31.0-5"
  },
  "devDependencies": {
    "@types/react": "^19.1.1",
    "prettier": "2.8.8",
    "react": "^19.2.3",
    "react-native": "^0.87.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "codegen": "./scripts/codegen.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
